---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import photosManifest from '../content/photos/manifest.json';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const homeProjects = projects.filter((project) => project.data.featuredHome);
const featuredProject = homeProjects.find((project) => project.data.type === 'product' && project.data.featured);
const secondaryProjects = homeProjects.filter((project) => project.id !== featuredProject?.id);
const previewPhotos = photosManifest
  .filter((photo) => photo.featured)
  .sort((a, b) => a.order - b.order)
  .slice(0, 4);
const recentPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => {
    const diff = b.data.date.valueOf() - a.data.date.valueOf();
    if (diff !== 0) return diff;
    return a.data.title.localeCompare(b.data.title);
  })
  .slice(0, 3);
const formatPostDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Forrest Chai"
  description="AI products, research projects, and photography by Forrest Chai."
>
  <Hero />

  <section class="section" id="projects">
    <div class="container">
      <SectionHeading title="Selected " emphasis="Work" index={`${homeProjects.length.toString().padStart(2, '0')} projects`} />
      <div class="project-grid">
        {featuredProject && <ProjectCard project={featuredProject} featured />}
        {secondaryProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split-grid">
        <div id="writing">
          <SectionHeading title="Recent " emphasis="writing" index={`latest ${recentPosts.length}`} />
          <ul class="post-list post-list--compact">
            {recentPosts.map((post) => {
              const slug = post.id.replace(/\.(md|mdx)$/, '');
              return (
                <li class="post-item">
                  <a href={`/blog/${slug}/`} class="post-link">
                    <div class="post-row-meta">
                      <time class="post-date" datetime={post.data.date.toISOString()}>
                        {formatPostDate(post.data.date)}
                      </time>
                    </div>
                    <div class="post-row-body">
                      <h3 class="post-title">{post.data.title}</h3>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
          <div class="photo-cta">
            <a href="/blog/">View all writing <span>&rarr;</span></a>
          </div>
        </div>

        <div class="photo-section" id="photography">
          <SectionHeading title="Through the " emphasis="lens" index="94 frames · selected" />
          <PhotoGrid photos={previewPhotos} href="/photography/" />
          <div class="photo-cta">
            <a href="/photography/">View all photos <span>&rarr;</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
