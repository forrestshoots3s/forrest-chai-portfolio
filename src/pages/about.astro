---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<BaseLayout
  title="About"
  description="About Forrest Chai."
>
  <header class="detail-hero">
    <div class="container">
      <p class="detail-kicker">About</p>
      <h1 class="detail-title">Builder, researcher, photographer.</h1>
      <p class="detail-dek">
        CS, Math &amp; HCI @ Northwestern. Regeneron Science Talent Search Scholar '25.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container about-columns">
      <article class="prose">
        <SectionHeading title="Short " emphasis="bio" />
        <p>
          CS, Math &amp; HCI @ Northwestern. Regeneron Science Talent Search Scholar '25. I build AI products at the application layer — LLM agents, agent harnesses, and the workflows that actually make them useful.
        </p>
        <p>
          Currently researching LLM agent–based search and recommendation at Northwestern's Delta Lab, and agentic frameworks at REAL Lab. In my free time, I photograph sunsets and the milky way.
        </p>
        <p>
          Always exploring and building, and always up to trade notes or collaborate on anything in applied AI. Reach me at <a href="mailto:forrestchai2029@u.northwestern.edu">forrestchai2029@u.northwestern.edu</a>.
        </p>
      </article>
      <aside>
        <SectionHeading title="Contact" />
        <ul class="contact-list">
          <li><a href="mailto:forrestchai2029@u.northwestern.edu">forrestchai2029@u.northwestern.edu</a></li>
          <li>Evanston, IL</li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>
